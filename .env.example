# Tricorder Neural Platform — Environment Variable Overrides
#
# Copy to .env and edit. Variables use the TRICORDER__ prefix with nested
# config paths separated by double underscores (__) so that field names
# containing single underscores (e.g. mcp_server, json_format) are preserved.
# Example: TRICORDER__LOGGING__LEVEL overrides config['logging']['level'].

# Core
TRICORDER__ENVIRONMENT=development

# Logging
TRICORDER__LOGGING__LEVEL=INFO
TRICORDER__LOGGING__JSON_FORMAT=false

# MCP Server
TRICORDER__MCP_SERVER__HOST=127.0.0.1
TRICORDER__MCP_SERVER__PORT=8000
TRICORDER__MCP_SERVER__AUTH_ENABLED=false
TRICORDER__MCP_SERVER__API_KEY=

# MQTT
TRICORDER__MQTT__HOST=localhost
TRICORDER__MQTT__PORT=1883
TRICORDER__MQTT__ENABLED=true

# Feature Flags
TRICORDER__FEATURE_FLAGS__ANOMALY_ACK=true
TRICORDER__FEATURE_FLAGS__AGENT_CHAT=true
TRICORDER__FEATURE_FLAGS__MQTT_PUBLISHING=true
