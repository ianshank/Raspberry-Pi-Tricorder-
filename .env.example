# Tricorder Neural Platform — Environment Variable Overrides
#
# Copy to .env and edit. Variables use the TRICORDER_ prefix with nested
# config paths separated by underscores (case-insensitive).
# Example: TRICORDER_LOGGING_LEVEL overrides config['logging']['level'].

# Core
TRICORDER_ENVIRONMENT=development

# Logging
TRICORDER_LOGGING_LEVEL=INFO
TRICORDER_LOGGING_JSON_FORMAT=false

# MCP Server
TRICORDER_MCP_SERVER_HOST=127.0.0.1
TRICORDER_MCP_SERVER_PORT=8000
TRICORDER_MCP_SERVER_AUTH_ENABLED=false
TRICORDER_MCP_SERVER_API_KEY=

# MQTT
TRICORDER_MQTT_HOST=localhost
TRICORDER_MQTT_PORT=1883
TRICORDER_MQTT_ENABLED=true

# Feature Flags
TRICORDER_FEATURE_FLAGS_STRUCTURED_LOGGING=false
TRICORDER_FEATURE_FLAGS_ANOMALY_ACK=true
TRICORDER_FEATURE_FLAGS_AGENT_CHAT=true
TRICORDER_FEATURE_FLAGS_MQTT_PUBLISHING=true
